<Window x:Class="StorageClean.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StorageClean"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource PrimaryBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="4" Height="9" Margin="1,7,1,0" RadiusX="1" Fill="#99FFFFFF" />
                            <Rectangle Width="4" Height="15" Margin="1,1,1,0" RadiusX="1" Fill="#CCFFFFFF" />
                            <Rectangle Width="4" Height="20" Margin="1,0,1,0" RadiusX="1" Fill="White" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="StorageClean" />
                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="Audit first. Confirm exact targets. Verify every result." />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource PrimarySoftBrush}" CornerRadius="20" Padding="12,7">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="READ-ONLY BETA  •  NO FILES CHANGED" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="24,20,24,0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Drive" />
                <ComboBox x:Name="DrivePicker"
                          Grid.Column="1"
                          Height="38"
                          Margin="12,0,16,0"
                          Padding="10,5"
                          DisplayMemberPath="Display"
                          VerticalContentAlignment="Center" />
                <Button x:Name="ScanButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="ScanButton_Click" Content="Scan drive" />
                <Button x:Name="CancelButton" Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click" Content="Cancel" IsEnabled="False" />
                <Button x:Name="ExportButton" Grid.Column="4" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="ExportButton_Click" Content="Export JSON" IsEnabled="False" />
                <StackPanel Grid.Column="5" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="Choose a drive and start a read-only scan." TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="ScanProgress" Height="4" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource PrimarySoftBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,14,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="CAPACITY" />
                    <TextBlock x:Name="CapacityText" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="-" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="USED" />
                    <TextBlock x:Name="UsedText" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="-" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="0,0,10,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="FREE" />
                    <TextBlock x:Name="FreeText" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="-" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="TOP-LEVEL ITEMS" />
                    <TextBlock x:Name="ItemsText" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="-" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="24,14,24,16" Padding="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="18,16,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Power-law ranking" />
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="Largest first. Recommendations are advisory and never execute an action." />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="Size  •  share  •  evidence  •  next action" />
                </Grid>

                <DataGrid x:Name="ResultsGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          Background="Transparent"
                          AlternatingRowBackground="#F8FAF9"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Location" Binding="{Binding Name}" Width="170" />
                        <DataGridTemplateColumn Header="Relative size" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding PercentOfLargest}" Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource PrimarySoftBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="105" />
                        <DataGridTextColumn Header="Used share" Binding="{Binding PercentOfUsed, StringFormat={}{0:F1}%}" Width="85" />
                        <DataGridTextColumn Header="Cumulative" Binding="{Binding CumulativePercent, StringFormat={}{0:F1}%}" Width="90" />
                        <DataGridTextColumn Header="Files" Binding="{Binding FileCount, StringFormat=N0}" Width="90" />
                        <DataGridTextColumn Header="Errors" Binding="{Binding ErrorCount, StringFormat=N0}" Width="70" />
                        <DataGridTextColumn Header="Suggested next action" Binding="{Binding Recommendation}" Width="*" MinWidth="280" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="v0.3.0 beta  •  Local scan  •  Reparse points excluded  •  Bounded concurrency" />
                <Button Grid.Column="1" BorderThickness="0" Background="Transparent" Foreground="{StaticResource PrimaryBrush}" Cursor="Hand" Click="WebsiteButton_Click" Content="storageclean.app" />
            </Grid>
        </Border>
    </Grid>
</Window>
